# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
POSTGRES_USER=dpdpa
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=dpdpa_reviewer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dpdpa:change_me_locally@localhost:5432/dpdpa_reviewer

# ---- Models ----
# Generation is swappable. Embeddings are always Gemini, because DeepSeek
# publishes no embedding endpoint and the corpus vectors must come from one
# consistent space or retrieval degrades without saying so.
AI_PROVIDER=deepseek

# Generation, when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Embeddings always, and generation when AI_PROVIDER=gemini.
# gemini-embedding-001 emits 3072 dimensions and is truncated to 768, which the
# corpus table is sized for. text-embedding-004 is retired.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

GEMINI_TEMPERATURE=0.1
# Thinking models bill internal reasoning against the output cap, so this must
# leave room for reasoning plus the JSON object.
GEMINI_MAX_OUTPUT_TOKENS=12288
GEMINI_MAX_RETRIES=4
GEMINI_MAX_RETRY_WAIT=65

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- Scanner limits ----
MAX_CRAWL_PAGES=10
CRAWL_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_SCAN=5000
SCAN_WORKSPACE_DIR=./workspace

# ---- RAG ----
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
GUARDRAIL_QUOTE_THRESHOLD=0.85
